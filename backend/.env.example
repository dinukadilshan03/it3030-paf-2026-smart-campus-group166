# Use one of the JDBC URLs from Supabase Connect.
# Prefer direct connection if your environment supports IPv6.
# Use Supavisor session mode if you need IPv4 support.
DB_URL=jdbc:postgresql://db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require
DB_USER=postgres
DB_PASSWORD=your-supabase-db-password
DB_MAX_POOL_SIZE=5
DB_MIN_IDLE=1
DB_CONNECTION_TIMEOUT_MS=30000
FRONTEND_URL=http://localhost:3000
# Google Cloud Console local redirect URI for student sign-in:
# http://localhost:8080/login/oauth2/code/google
BOOTSTRAP_ADMIN_EMAIL=bootstrap-admin@example.com
BOOTSTRAP_ADMIN_TEMP_PASSWORD=change-me-bootstrap
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_RESOURCE_IMAGES_BUCKET=resource-images
SUPABASE_TICKET_ATTACHMENTS_BUCKET=ticket-attachments
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

LOCAL_AUTH_MAX_FAILED_ATTEMPTS=5
LOCAL_AUTH_LOCK_DURATION_MINUTES=15
