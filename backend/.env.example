# SmartCampus backend supports Supabase only.
# Pick one connection mode from Supabase Connect:
# - pooler: better fallback for IPv4-only or restrictive networks
# - direct: use this when pooler times out on your machine
DB_CONNECTION_MODE=pooler
DB_URL_POOLER=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_URL_DIRECT=jdbc:postgresql://db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require
DB_USER_POOLER=postgres.<your-project-ref>
DB_USER_DIRECT=postgres
# Optional compatibility fallback if both modes use the same username in your project:
# DB_USER=postgres
DB_PASSWORD=your-supabase-db-password
DB_MAX_POOL_SIZE=5
DB_MIN_IDLE=1
DB_CONNECTION_TIMEOUT_MS=30000

# Connectivity check on Windows:
# Test-NetConnection aws-0-<region>.pooler.supabase.com -Port 5432
# If pooler mode times out, switch DB_CONNECTION_MODE to direct and test the direct host.

FRONTEND_URL=http://localhost:3000
# Google Cloud Console local redirect URI for student sign-in:
# http://localhost:8080/login/oauth2/code/google
BOOTSTRAP_ADMIN_EMAIL=bootstrap-admin@example.com
BOOTSTRAP_ADMIN_TEMP_PASSWORD=change-me-bootstrap
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_RESOURCE_IMAGES_BUCKET=resource-images
SUPABASE_TICKET_ATTACHMENTS_BUCKET=ticket-attachments
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

LOCAL_AUTH_MAX_FAILED_ATTEMPTS=5
LOCAL_AUTH_LOCK_DURATION_MINUTES=15
